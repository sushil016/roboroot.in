{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/server.mts",
      "framework": "express",
      "installCommand": "pnpm install --frozen-lockfile --config.node-linker=hoisted",
      "buildCommand": "pnpm run build"
    }
  },
  "rewrites": [
    {
      "source": "/_/backend/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
